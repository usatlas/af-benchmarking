{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Payload",
  "description": "Schema for benchmark log data sent to LogStash/Kibana",
  "type": "object",
  "required": [
    "job",
    "cluster",
    "submitTime",
    "queueTime",
    "runTime",
    "payloadSize",
    "status",
    "host",
    "os",
    "mode",
    "containerized",
    "token",
    "kind"
  ],
  "properties": {
    "job": {
      "type": "string",
      "description": "Job name (e.g., 'rucio', 'eventloop-columnar', 'evnt-native')",
      "minLength": 1,
      "pattern": "^[a-z0-9_-]+$"
    },
    "cluster": {
      "type": "string",
      "description": "Cluster name where the benchmark ran",
      "enum": ["UC-AF", "SLAC-AF", "BNL-AF"]
    },
    "submitTime": {
      "type": "integer",
      "description": "Job submit timestamp in milliseconds since epoch (UTC)",
      "minimum": 0
    },
    "queueTime": {
      "type": "integer",
      "description": "Time spent in queue in seconds",
      "minimum": 0
    },
    "runTime": {
      "type": "integer",
      "description": "Job execution time in seconds",
      "minimum": 0
    },
    "payloadSize": {
      "type": "integer",
      "description": "Size of payload in bytes (-1 if not provided, 0 for empty file)",
      "minimum": -1
    },
    "frequency": {
      "type": "number",
      "description": "Frequency or event processing rate (kHz)",
      "minimum": 0
    },
    "setupTime": {
      "type": "integer",
      "description": "Environment setup time in seconds (setupATLAS + asetup/lsetup)",
      "minimum": 0
    },
    "status": {
      "type": "integer",
      "description": "Job exit status (0 = success, non-zero = failure)",
      "minimum": 0
    },
    "host": {
      "type": "string",
      "description": "Hostname where the job executed",
      "format": "idn-hostname",
      "minLength": 1
    },
    "os": {
      "type": "string",
      "description": "Operating System for the job",
      "enum": ["centos7", "alma9"]
    },
    "mode": {
      "type": "string",
      "description": "Mode of the job - batch or interactive",
      "enum": ["batch", "interactive"]
    },
    "containerized": {
      "type": "boolean",
      "description": "Whether the job runs within a 'setupATLAS -c' container"
    },
    "token": {
      "type": "string",
      "description": "Authentication token for LogStash routing",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "description": "Kind identifier for LogStash routing",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
